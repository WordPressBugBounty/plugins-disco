{
	"name": "webappick/disco",
	"description": "Discount Plugin for WooCommerce",
	"license": "GPL-3.0-or-later",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Ohidul Islam",
			"email": "wahid0003@gmail.com",
			"homepage": "https://webappick.com"
		}
	],
	"homepage": "https://webappick.com",
	"require": {
		"php": ">=7.4",
		"inpsyde/assets": "2.8.3",
		"inpsyde/wp-context": "1.5.0",
		"micropackage/requirements": "1.2.2"
	},
	"require-dev": {
		"10up/wp_mock": "^1.0",
		"cmb2/cmb2": "~2.9.0",
		"codeatcode/codeatcs": "^1.0",
		"codeception/codeception": "~4.2.0",
		"codeception/module-asserts": "^1.0",
		"codeception/module-cli": "^1.0",
		"codeception/module-db": "^1.0",
		"codeception/module-filesystem": "^1.0",
		"codeception/module-phpbrowser": "^1.0",
		"codeception/module-rest": "^1.2",
		"codeception/module-webdriver": "^1.0",
		"codeception/util-universalframework": "^1.0",
		"composer/installers": "2.2.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"ergebnis/composer-normalize": "^2.42",
		"lucatume/function-mocker": "^1.0",
		"lucatume/wp-browser": "3.5.6",
		"origgami/cmb2-grid": "dev-master",
		"php-stubs/wordpress-stubs": "5.8.0.0",
		"phpro/grumphp": "^1.13",
		"phpunit/phpunit": "~9.6.0",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"wp-coding-standards/wpcs": "dev-develop",
		"wpbp/cpt_columns": "~1.0.0",
		"wpbp/cronplus": "~1.0.0",
		"wpbp/debug": "~1.1.0",
		"wpbp/i18n-notice": "dev-main",
		"wpbp/page-madness-detector": "^1.0",
		"wpbp/pointerplus": "~1.0.0",
		"wpbp/template": "~1.0.0",
		"wpbp/widgets-helper": "~1.0.0"
	},
	"repositories": [
		{
			"type": "git",
			"url": "https://github.com/ayecode/wp-super-duper"
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Disco\\Ajax\\": "ajax/",
			"Disco\\App\\": "app/",
			"Disco\\Backend\\": "backend/",
			"Disco\\Cli\\": "cli/",
			"Disco\\Engine\\": "engine/",
			"Disco\\Frontend\\": "frontend/",
			"Disco\\Integrations\\": "integrations/",
			"Disco\\Internals\\": "internals/",
			"Disco\\Notice\\": "notice/",
			"Disco\\Rest\\": "rest/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"cweagans/composer-patches": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"ergebnis/composer-normalize": true,
			"phpro/grumphp": true
		},
		"platform": {
			"php": "7.4"
		}
	},
	"extra": {
		"installer-paths": {
			"vendor/{$name}/": [
				"cmb2/cmb2",
				"origgami/cmb2-grid",
				"stevegrunwell/wp-cache-remember"
			]
		},
		"patches": {
			"ayecode/wp-super-duper": {
				"Fix v2": "https://patch-diff.githubusercontent.com/raw/AyeCode/wp-super-duper/pull/25.patch"
			}
		}
	},
	"scripts": {
		"cbf": "phpcbf --standard=phpcs.xml .",
		"cs": "phpcs --standard=phpcs.xml ."
	}
}
